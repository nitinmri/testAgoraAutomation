{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [ "pages/**/*.ts",
  "utils/**/*.ts",
  "tests/**/*.ts",
  "playwright.config.ts"]
}
